{{- /*
Dev containers may set CLAUDE_CONFIG_DIR to a persistent volume; write the
managed settings there too so they still apply. -ef compares the resolved
directories, so trailing slashes, a literal ~ and symlinks to ~/.claude are
all treated as the default location.
*/ -}}
{{- $dir := regexReplaceAll "^~" (env "CLAUDE_CONFIG_DIR") (env "HOME") -}}
{{- if and (ne .chezmoi.os "windows") $dir -}}
{{-   if not (output "sh" "-c" `[ "$1" -ef "$2" ] && echo default; :` "sh" $dir (joinPath (env "HOME") ".claude")) -}}
{{-     $content := includeTemplate "claude-settings.json" . -}}
{{-     template "write-file.sh" (dict "path" (joinPath $dir "settings.json") "content" $content) -}}
{{-   end -}}
{{- end -}}
