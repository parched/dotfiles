{{ if eq (dig "osRelease" "variantID" "" .chezmoi) "cosmic-atomic" -}}
#!/usr/bin/env bash

# User-level setup for Fedora COSMIC Atomic. Re-runs when this script or the
# managed systemd units change:
# fix-chrome-pwas.path: {{ include "private_dot_config/systemd/user/fix-chrome-pwas.path" | sha256sum }}
# fix-chrome-pwas.service: {{ include "private_dot_config/systemd/user/fix-chrome-pwas.service" | sha256sum }}
# flatpak-user-update.service: {{ include "private_dot_config/systemd/user/flatpak-user-update.service" | sha256sum }}
# flatpak-user-update.timer: {{ include "private_dot_config/systemd/user/flatpak-user-update.timer" | sha256sum }}
# voxtype.service: {{ include "private_dot_config/systemd/user/voxtype.service" | sha256sum }}
# voxtype config: {{ include "private_dot_config/voxtype/config.toml" | sha256sum }}

set -euo pipefail

{{ template "fetch.sh" }}
bin_dir="$HOME/.local/bin"

echo "Adding Flathub remote..."
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

if ! flatpak info com.google.Chrome >/dev/null 2>&1; then
  echo "Installing Google Chrome from Flathub..."
  flatpak install -y --noninteractive flathub com.google.Chrome
else
  echo "Google Chrome is already installed."
fi

# The icons symlink that PWA .desktop files rely on is managed by chezmoi at
# ~/.var/app/com.google.Chrome/data/icons.
echo "Allowing Google Chrome to install PWAs..."
flatpak override --user \
  --filesystem=~/.local/share/applications:create \
  --filesystem=~/.local/share/icons:create \
  com.google.Chrome

if [ "$(xdg-settings get default-web-browser 2>/dev/null)" != "com.google.Chrome.desktop" ]; then
  echo "Setting Google Chrome as the default web browser..."
  xdg-settings set default-web-browser com.google.Chrome.desktop
else
  echo "Google Chrome is already the default web browser."
fi

gcm_version="2.9.1"
gcm_dir="$HOME/.local/share/gcm"
gcm="$bin_dir/git-credential-manager"
if [ "$("$gcm" --version 2>/dev/null | cut -d+ -f1)" != "$gcm_version" ]; then
  case "$(uname -m)" in
    x86_64) gcm_arch="x64" ;;
    aarch64) gcm_arch="arm64" ;;
    *) echo "Unsupported architecture for Git Credential Manager: $(uname -m)" >&2; exit 1 ;;
  esac
  echo "Installing Git Credential Manager $gcm_version to $gcm_dir..."
  rm -rf "$gcm_dir"
  mkdir -p "$gcm_dir" "$bin_dir"
  fetch "https://github.com/git-ecosystem/git-credential-manager/releases/download/v$gcm_version/gcm-linux-$gcm_arch-$gcm_version.tar.gz" \
    | tar -xz -C "$gcm_dir"
  ln -sf "$gcm_dir/git-credential-manager" "$gcm"
else
  echo "Git Credential Manager $gcm_version is already installed at $gcm."
fi

voxtype_version="1.1.1"
voxtype="$bin_dir/voxtype"
if [ "$("$voxtype" --version 2>/dev/null | awk '{ print $2 }')" != "$voxtype_version" ]; then
  if [ "$(uname -m)" != "x86_64" ]; then
    echo "Unsupported architecture for voxtype: $(uname -m)" >&2; exit 1
  elif compgen -G "/dev/dri/renderD*" >/dev/null; then
    voxtype_build="vulkan"
  elif grep -qw avx512f /proc/cpuinfo; then
    voxtype_build="avx512"
  elif grep -qw avx2 /proc/cpuinfo; then
    voxtype_build="avx2"
  else
    voxtype_build="baseline"
  fi
  echo "Installing voxtype $voxtype_version ($voxtype_build) to $voxtype..."
  mkdir -p "$bin_dir"
  fetch "https://github.com/peteonrails/voxtype/releases/download/v$voxtype_version/voxtype-$voxtype_version-linux-x86_64-$voxtype_build" \
    > "$voxtype.tmp"
  chmod +x "$voxtype.tmp"
  mv "$voxtype.tmp" "$voxtype"
else
  echo "voxtype $voxtype_version is already installed at $voxtype."
fi
"$voxtype" setup --download --model large-v3-turbo --quiet

echo "Enabling automatic user Flatpak updates, Chrome PWA fixes and voxtype..."
systemctl --user daemon-reload
systemctl --user enable --now flatpak-user-update.timer fix-chrome-pwas.path voxtype.service
# Pick up a new voxtype binary or config.
systemctl --user restart voxtype.service
"$bin_dir/fix-chrome-pwas"
{{ end -}}
