[user]
	name = "James Duley"
	email = {{ .email | quote }}
{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
[credential]
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{{- else if and (eq .chezmoi.os "linux") (eq (get .chezmoi.osRelease "id") "fedora") (eq (get .chezmoi.osRelease "variantID") "cosmic-atomic") }}
[credential]
	helper = {{ .chezmoi.homeDir }}/.local/bin/git-credential-manager
	credentialStore = secretservice
{{- end }}
[color]
	ui = true
[push]
	default = upstream
[alias]
	loga = log --graph --all --decorate --oneline
	logg = log --graph --decorate --oneline
	logs = log --stat
	diffc = diff --cached
	dc = diff --cached
	co = checkout
	br = branch
	ci = commit
	st = status
	rb = rebase
	rbi = rebase -i
	rbc = rebase --continue
	rba = rebase --abort
	roh = rebase origin/HEAD --interactive --update-refs
	rbs = "!f() { [ -z \"$1\" ] && echo \"Usage: git rbs <branch>\" && exit 1; git reset --soft $(git merge-base HEAD \"$1\") && git commit -C ORIG_HEAD && git rebase \"$1\"; }; f"
	fu = absorb --and-rebase
	nb = switch origin/HEAD -c
	b = for-each-ref --sort=-committerdate refs/heads/ --format='%(color:yellow)%(committerdate:relative)%(color:reset) %(HEAD)%(color:green)%(refname:short)%(color:reset)%(color:cyan) -> %(upstream:short)%(color:reset) %(color:magenta)%(upstream:track)%(color:reset) %(color:blue)%(objectname:short)%(color:reset) %(color:white)%(subject)%(color:reset)'
[rebase]
	autoSquash = true
	autoStash = true
[interactive]
	singleKey = true
[advice]
	detachedHead = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "github.com"]
	useHttpPath = true
[init]
	defaultBranch = main
